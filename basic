20. Armstrong

using System;

class Program
{
    static void Main()
    {
        int n = Convert.ToInt32(Console.ReadLine());
        int t = n, sum = 0;

        while (n > 0)
        {
            int r = n % 10;
            sum += r * r * r;
            n /= 10;
        }

        Console.WriteLine(sum == t ? "Armstrong" : "Not Armstrong");
    }
}

